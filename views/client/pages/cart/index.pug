extends ../layouts/default.pug
include ../mixins/box-head.pug


block main

  .container.mb-3
    .row
      .col-12
        +box-head(pageTitle)

    .row
      .col-12
        table(class="table table-bordered")
          thead
            tr
              th STT
              th Hình ảnh
              th Tiêu đề
              th Giá
              th Số lượng
              th Tổng tiền
              th Hành động
          tbody(list-tour)
            
        else
          p Không có sản phẩm nào trong giỏ hàng

        h5(class="text-right mb-4") Tổng đơn hàng <span total-price>0</span>


    .row
      .col-12
        +box-head("Thông tin khách hàng")

        form(form-order)
          div(class="form-group")
            label(for="fullName") Họ tên
            input(
              type="text"
              class="form-control"
              id="fullName"
              name="fullName"
              required
            )
          div(class="form-group")
            label(for="phone") SĐT
            input(
              type="text"
              class="form-control"
              id="phone"
              name="phone"
              required
            ) 
          div(class="form-group")
            label(for="note") Ghi chú
            textarea(
              class="form-control"
              id="note"
              name="note"
              row="2"
            )
          div(class="form-group")
            button(
              type="submit"
              class="btn btn-success btn-block"
              ) Đặt tour
      
  block script 
    script(src="/js/cart.js") 

